# Copy this file to `.env.local` and paste your Supabase keys.
#
# WITHOUT THESE the app falls back to browser storage: there is no sign-in,
# and every device keeps its own private copy of the data. Set them wherever
# the app actually runs — including Vercel (Settings -> Environment
# Variables) — or nobody shares a database.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only — needed to create and edit staff sign-in accounts from the
# Users screen. NEVER prefix this one with NEXT_PUBLIC_: that would ship it to
# the browser, where it would hand anyone full access to the database.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
